# LLM back-end: llamacpp (default, local GGUF), groq (free API tier), ollama, local (transformers)
FINRAG_LLM_PROVIDER=llamacpp
# Leave empty to use the provider default
FINRAG_LLM_MODEL=

# Only needed for the groq provider - free key at https://console.groq.com
GROQ_API_KEY=

# Ollama server, only needed for the ollama provider
OLLAMA_URL=http://localhost:11434

# Retrieval
FINRAG_TOP_K=3
FINRAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
FINRAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
